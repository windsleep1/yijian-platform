# =====================================================================
#  一建通 · 环境变量模板
#  用法： cp .env.example .env  然后逐项替换为真实值
#  ⚠️  .env 必须加入 .gitignore，禁止提交到代码仓库
# =====================================================================

# ---------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------
APP_NAME=一建通
APP_ENV=local                       # local | dev | staging | prod
APP_DEBUG=true
APP_PORT=8000
API_HOST_PORT=8000                  # 宿主机映射端口，冲突时改这里
DB_WAIT_TIMEOUT=120                 # API 启动时等待 PostgreSQL 的超时秒数
REDIS_WAIT_TIMEOUT=60
APP_TIMEZONE=Asia/Shanghai
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# 生成方式： python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_please_generate_a_48_char_random_string
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_DB=yijian
POSTGRES_USER=yijian
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://yijian:CHANGE_ME_strong_db_password@postgres:5432/yijian
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# PostgreSQL 容器参数。默认值偏保守，保证笔记本 Docker Desktop 也能起来。
# 4C8G 及以上生产机建议：PG_SHARED_BUFFERS=1GB、PG_EFFECTIVE_CACHE_SIZE=3GB、PG_MAX_CONNECTIONS=200
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB

# ---------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_HOST_PORT=6379
REDIS_MAXMEMORY=512mb
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/0
# 验证码/登录态等不可丢数据使用 1 号库（该库 key 均设置 TTL，不会被 LRU 淘汰）
REDIS_URL_PERSIST=redis://:CHANGE_ME_strong_redis_password@redis:6379/1

# ---------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------
# 生成方式： python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_another_48_char_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=120        # access token 有效期（分钟）
REFRESH_TOKEN_TTL_DAYS=30           # refresh token 有效期（天）
JWT_ISSUER=yijian

# ---------------------------------------------------------------------
# 短信（阿里云 / 腾讯云，二选一）
# ---------------------------------------------------------------------
# mock = 不发真短信，验证码写 Redis 并在 /auth/sms/send 响应里回显（仅非生产环境）
#        保证 docker compose 起来就能跑通全流程，无需先申请短信服务
SMS_PROVIDER=mock                   # mock | aliyun | tencent
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=一建通
SMS_TEMPLATE_REGISTER=SMS_100001
SMS_TEMPLATE_LOGIN=SMS_100002
SMS_TEMPLATE_RESET=SMS_100003
SMS_CODE_TTL_SECONDS=300
SMS_DAILY_LIMIT_PER_PHONE=10
SMS_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------
# Meilisearch
# ---------------------------------------------------------------------
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key
MEILI_ENV=production                # 本地开发可改为 development
MEILI_HOST_PORT=7700
MEILI_URL=http://meilisearch:7700
MEILI_INDEX_QUESTIONS=questions
MEILI_INDEX_LESSONS=lessons

# ---------------------------------------------------------------------
# 对象存储 MinIO / S3 兼容
# ---------------------------------------------------------------------
MINIO_ROOT_USER=yijian_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=yijian-media           # 公开读（课程封面、讲义、分享图）
MINIO_BUCKET_PRIVATE=yijian-private # 私有（导入文件、原始视频）
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001

# ---------------------------------------------------------------------
# 微信（二期启用）
# ---------------------------------------------------------------------
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_pay_key.pem
WECHAT_PAY_NOTIFY_URL=https://www.example.com/api/v1/payments/notify/wechat

# ---------------------------------------------------------------------
# 支付宝（二期启用）
# ---------------------------------------------------------------------
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=/run/secrets/alipay_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/run/secrets/alipay_public_key.pem
ALIPAY_NOTIFY_URL=https://www.example.com/api/v1/payments/notify/alipay

# ---------------------------------------------------------------------
# 业务参数
# ---------------------------------------------------------------------
EXAM_CURRENT_YEAR=2027
PRACTICE_PAYWALL_AFTER=10           # 免费用户答题 N 题后触发付费墙
PRACTICE_DAILY_COUNT=10
RATE_LIMIT_PER_MINUTE=120           # 单用户每分钟请求上限
RATE_LIMIT_ANSWER_PER_MINUTE=300    # 答题接口每分钟上限
RATE_LIMIT_SMS_PER_DAY=10

# ---------------------------------------------------------------------
# 媒体与转码
# ---------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
HLS_SEGMENT_SECONDS=6
HLS_RENDITIONS=360p,480p,720p
PLAY_URL_TTL_SECONDS=300            # 播放地址签名有效期（秒）

# ---------------------------------------------------------------------
# 定时任务
# ---------------------------------------------------------------------
CELERY_BROKER_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/2
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_strong_redis_password@redis:6379/3
CELERY_TIMEZONE=Asia/Shanghai

# ---------------------------------------------------------------------
# 监控与日志
# ---------------------------------------------------------------------
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
SENTRY_DSN=
PROMETHEUS_ENABLED=true
SLOW_QUERY_THRESHOLD_MS=500

# ---------------------------------------------------------------------
# 备份
# ---------------------------------------------------------------------
BACKUP_DIR=/backup/postgres
BACKUP_KEEP_DAYS=30
BACKUP_S3_ALIAS=backup
BACKUP_S3_PATH=backup/yijian-db

# ---------------------------------------------------------------------
# 管理端
# ---------------------------------------------------------------------
# API 容器启动时会用这组账号创建/修复超管（幂等）。首次部署后请改掉默认密码。
ADMIN_INIT_PHONE=13800000000
ADMIN_INIT_PASSWORD=Admin@123456
ADMIN_ALLOWED_IPS=                  # 逗号分隔，留空表示不限制（生产建议限制）

# ---------------------------------------------------------------------
# 安全（Batch 2 新增）
# ---------------------------------------------------------------------
LOGIN_MAX_FAILURES=5                # 密码连续错误次数上限
LOGIN_LOCK_SECONDS=900              # 触发上限后锁定秒数
TRUST_PROXY_HEADERS=true            # 部署在 Nginx 后面时按 X-Forwarded-For 取真实 IP
SNOWFLAKE_WORKER_ID=1               # 多实例部署时每个实例必须不同（0~1023）
