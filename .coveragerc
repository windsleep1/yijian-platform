# 覆盖率配置 —— 门禁整顿第二步（Commit A）引入。
#
# ⚠️ 这里**刻意不写 `source`**：`source` 的相对路径是按**进程 cwd** 解析的，
# 而覆盖率是在 **API 进程**里采集的（见 `tools/local-verify/serve_fake_redis.py` 的
# `--coverage`），那个进程会把 cwd 切到 `apps/api`。把 source 写在代码里，
# 只有一处、且与切换 cwd 的动作挨着，不会出现"换个目录就跑不起来"。
# 本文件负责 `[report]` 的展示口径与**门槛**。

[report]
# ---- 门槛 ----
#
# **实测依据（2026-09-20 首次测量，不是拍脑袋）**：
#
#     44 个文件 / 4305 条语句 / 未覆盖 1479  →  **65.64%**
#
#     schemas       925 语句   14 未覆盖   98.5%
#     db            152 语句   10 未覆盖   93.4%
#     core          398 语句   59 未覆盖   85.2%
#     api           322 语句   51 未覆盖   84.2%
#     services     2286 语句 1153 未覆盖   49.6%   ← 大头；缺的是 Batch 8+ 还没写的代码
#     (顶层)        222 语句  192 未覆盖   13.5%   ← cli.py / main.py，只有启动路径被跑到
#
# ⚠️ **一个必须说明的冲突，不藏在这里**：
#
# 用户的要求是「实测值 +5~10 个百分点」，即 65.64 + 5.4 ≈ **71%**。
# 但 71% > 65.64% —— 门槛一落地 `coverage report` 就必然非 0 退出，
# 于是 `run-smoke.ps1` 不再"从零库全绿"、CI 也白不起来。
# 而用户自己定过两条判据：**「恒红的门禁等于没有门禁」**（硬约定 H）；
# 以及本批验收里明写的「run-smoke.ps1 从零库仍绿」。
#
# 两条要求**在数学上不能同时成立**，所以取"门禁必须真能跑"这一条（它是原则，
# 另一条是算术），把门槛定在**实测值下方一点点**作为**棘轮**：
#
#     fail_under = 65   ← 实测 65.64%，留 0.64pp 抖动余量
#
# 效果：**任何让覆盖率掉 1 个点以上的改动都会红** —— 这才是棘轮的作用。
#
# **抬高它的时机与办法**：每批新增业务代码后重测，若实测值比门槛高出 3pp 以上，
# 就把 `fail_under` 提到「实测值 − 1」。
# 用户的 71% 目标**记为下一档**：`services` 从 49.6% 往上走（补 Batch 8+ 的用例）
# 或 `cli.py` 补 CLI 直测，任一推进都能越过 71%。**达到后再把这一行改成 71。**
#
# **刻意不设 80%**：把门槛定在"现在做不到"的位置，唯一效果是逼人写凑数的测试
# 去把数字抬上来，那是把覆盖率变成装饰品。

fail_under = 65

# 默认不打印逐文件明细（总览足够做门禁；要看细节加 --show-missing）
show_missing = false
skip_covered = false

# 这些行**没有可执行语义**，算进分母只会压低数字并诱使人为它写无意义的测试。
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    \.\.\.$
    raise NotImplementedError
